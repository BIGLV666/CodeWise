# CodeWise Docker 部署环境变量模板
# 复制为 deploy/.env 后修改；.env 不要提交到仓库。

# ---- 鉴权与密钥（必须，全部服务共用同一 Token）----
# 内部通信 Token：网关注入、下游校验、Feign 透传三处同值
CODEWISE_INTERNAL_TOKEN=change-me-to-a-long-random-string
# JWT 签名密钥（gateway / user / message / review 使用；需与 Python Agent .env 同值）
JWT_SECRET=change-me-to-a-32byte-or-longer-secret
# 用户自定义模型 API Key 的 AES-GCM 主密钥（32 字节 Base64，service-ai 使用）
API_KEY_MASTER_KEY=

# ---- root 管理员引导（service-user 首次启动自动创建）----
ROOT_PASSWORD=change-me-strong-password
ROOT_EMAIL=
ROOT_NICKNAME=
ROOT_PHONE=

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USER=codewise
MYSQL_PASSWORD=change-me-db-password

# ---- RabbitMQ ----
RABBITMQ_USER=codewise
RABBITMQ_PASS=change-me-mq-password

# ---- 邮件 SMTP（可选：默认用容器内 Mailpit 捕获邮件，Web 界面 http://127.0.0.1:8025）----
# 接真实 SMTP 时填写以下项（留空则使用 Mailpit），发件地址默认 codewise@noreply.local
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
CODEWISE_MAIL_FROM=

# ---- Python Agent（codewise-agent 容器，经 nginx /agentapi/ 暴露）----
# LLM 供应商路由：codewise = llm-pi-ai 手工路由（纯净 OpenAI 协议，默认）
DSH_PROVIDER=codewise
DSH_DEFAULT_CONTEXT_WINDOW=65536
DSH_IDLE_TIMEOUT_SECONDS=600

# ---- 网关 CORS（逗号分隔，生产改为你的域名）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# ---- 镜像源（可选）----
# 默认使用本地构建的 codewise/* 镜像。等 CI 发布到 GHCR 后，取消注释
# 即可直接拉取镜像、无需本地构建（命名规则与 .github/workflows/docker-images.yml 一致）：
# CODEWISE_IMAGE_PREFIX=ghcr.io/<owner>/codewise-
# 判题基础镜像同理（默认 codewise-java-judge:17）：
# JUDGE_IMAGE=ghcr.io/<owner>/codewise-java-judge:17
