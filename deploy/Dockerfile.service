# syntax=docker/dockerfile:1
# CodeWise 业务服务通用镜像模板（service-judge-go 不在部署范围）。
# 用法（在仓库根目录执行）：
#   docker build -f deploy/Dockerfile.service \
#     --build-arg MODULE=service-question \
#     --build-arg INSTALL_DOCKER_CLI=true \
#     -t codewise/service-question:latest .
#
# 说明：仓库无聚合 POM，先 install 共享模块再 package 目标模块。
ARG MODULE=service-user

# ---------- 构建阶段 ----------
FROM maven:3.9-eclipse-temurin-21 AS build
ARG MODULE
WORKDIR /repo
COPY pom.xml ./
COPY service-common service-common
COPY service-api service-api
COPY ${MODULE} ${MODULE}
RUN mvn -q -f service-common/pom.xml -DskipTests install \
 && mvn -q -f service-api/pom.xml -DskipTests install \
 && mvn -q -f ${MODULE}/pom.xml -DskipTests package

# ---------- 运行阶段 ----------
FROM eclipse-temurin:21-jre AS runtime
ARG MODULE
# service-question 通过 docker CLI 在沙箱内验收 AI 产物（InternalJavaArtifactJudge）
ARG INSTALL_DOCKER_CLI=false
RUN if [ "$INSTALL_DOCKER_CLI" = "true" ]; then \
        apt-get update && apt-get install -y --no-install-recommends docker.io curl \
        && rm -rf /var/lib/apt/lists/* ; \
    else \
        apt-get update && apt-get install -y --no-install-recommends curl \
        && rm -rf /var/lib/apt/lists/* ; \
    fi \
 && useradd -r -u 1000 -m codewise
WORKDIR /app
COPY --from=build /repo/${MODULE}/target/*.jar /app/app.jar
RUN mkdir -p /app/data \
 && chown -R codewise:codewise /app
ENV TZ=Asia/Shanghai
USER codewise
EXPOSE 8080
# 判题/容器管理路径由 compose 单独覆盖（judge 需要访问 Docker daemon，以 root 运行）
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
