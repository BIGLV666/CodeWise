# CodeWise 业务服务通用镜像模板（service-judge-go 不在部署范围）。
# 用法（在仓库根目录执行）：
#   docker build -f deploy/Dockerfile.service \
#     --build-arg MODULE=service-question \
#     --build-arg INSTALL_DOCKER_CLI=true \
#     -t codewise/service-question:latest .
#
# 说明：仓库无聚合 POM，先 install 共享模块再 package 目标模块。
ARG MODULE=service-user

# ---------- 构建阶段 ----------
FROM maven:3.9-eclipse-temurin-21 AS build
ARG MODULE
WORKDIR /repo
COPY pom.xml ./
COPY service-common service-common
COPY service-api service-api
COPY ${MODULE} ${MODULE}
# Maven 仓库走 BuildKit 缓存挂载：跨镜像构建复用依赖下载，重复构建显著提速。
# 顺序：先 -N install 根 POM（模块 pom 的 parent 指向它），再 api（common 依赖它），
# 最后目标模块——冷缓存下才能解析通过
RUN --mount=type=cache,target=/root/.m2 \
    mvn -q -f pom.xml -N install \
 && mvn -q -f service-api/pom.xml -DskipTests install \
 && mvn -q -f service-common/pom.xml -DskipTests install \
 && mvn -q -f ${MODULE}/pom.xml -DskipTests package

# ---------- 运行阶段 ----------
FROM eclipse-temurin:21-jre AS runtime
ARG MODULE
# service-question 通过 docker CLI 在沙箱内验收 AI 产物（InternalJavaArtifactJudge）
ARG INSTALL_DOCKER_CLI=false
RUN if [ "$INSTALL_DOCKER_CLI" = "true" ]; then \
        apt-get update && apt-get install -y --no-install-recommends docker.io curl \
        && rm -rf /var/lib/apt/lists/* ; \
    else \
        apt-get update && apt-get install -y --no-install-recommends curl \
        && rm -rf /var/lib/apt/lists/* ; \
    fi

# 新版基础镜像（Ubuntu 24.04 系）自带 uid 1000 的 ubuntu 用户，先删除再建 codewise
RUN (getent passwd 1000 >/dev/null && userdel -r "$(id -nu 1000)") || true \
 && useradd -r -u 1000 -m codewise
WORKDIR /app
COPY --from=build /repo/${MODULE}/target/*.jar /app/app.jar
# /app/logs 供 GC 日志落盘：compose 以 service-logs 卷挂载到该路径，重建容器不丢历史
# /app/data/uploads 是 service-user 的上传目录（compose 挂 user-uploads 卷）。
# 两者的目录与属主都必须先建在镜像里：空命名卷首次挂载会继承镜像目录的属主，
# 若镜像里没有该目录，Docker 会以 root:root 新建挂载点，非 root 的服务进程写不进去
# （曾导致头像/题目配图上传一律报「文件保存失败」）。
RUN mkdir -p /app/data /app/data/uploads /app/logs \
 && chown -R codewise:codewise /app
ENV TZ=Asia/Shanghai
# GC 日志文件名按模块区分（各服务共用一个卷，同目录下互不覆盖）
ENV GC_LOG_FILE=/app/logs/gc-${MODULE}.log
USER codewise
EXPOSE 8080
# 判题/容器管理路径由 compose 单独覆盖（judge 需要访问 Docker daemon，以 root 运行）
#
# 内存策略（防止容器被 OOM kill）：
# - 堆上限按容器限额的 45% 计（Spring Boot 服务 384m-768m 限额对应 172m-345m 堆，足够）；
# - Metaspace 封顶 160m，避免类元数据随限额水涨船高；
# - 线程栈 512k（默认 1m），Spring 应用线程多，栈是 RSS 大头之一。
#
# GC 日志：统一日志（JDK 9+）落文件并轮转——filecount=5、filesize=10M，上限约
# (5+1)×10M=60M/服务，不会无限追加；只保留 GC 事件（gc* 含堆详情），与 stdout 应用日志
# 分离便于排查。用 sh -c + exec 启动：exec 让 java 仍是 PID 1，容器信号与退出码语义不变。
ENTRYPOINT ["sh", "-c", "exec java -XX:MaxRAMPercentage=45.0 -XX:MaxMetaspaceSize=160m -Xss512k -Xlog:gc*:file=${GC_LOG_FILE}:time,uptime,level,tags:filecount=5,filesize=10M -jar /app/app.jar"]
