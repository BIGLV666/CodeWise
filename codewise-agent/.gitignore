# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# 运行期产物（dsh 会话日志、token 文件）
data/

# 冒烟脚本临时产物
tests/.smoke-tmp/
tests/.smoke-web-tmp/

# Node 运行时闭包
agent-runtime/node_modules/
agent-runtime/plugins/*/node_modules/
agent-runtime/plugins/codewise-tools/dist/
agent-runtime/plugins/codewise-web/dist/
# 注：agent-runtime/package-lock.json 必须入库。codewise-agent/Dockerfile 用 `npm ci` 安装，
# 缺 lockfile 时干净 clone 上构建必然失败（此前该文件被本行忽略，属仓库缺陷）。

# 环境配置（含密钥）
.env
