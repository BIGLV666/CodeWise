DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/codewise_ai?charset=utf8mb4
API_KEY_MASTER_KEY=replace_with_32_byte_base64_key
CODEWISE_GATEWAY_URL=http://127.0.0.1:8082
JWT_SECRET=codewise-jwt-secret-key-must-be-at-least-256-bits-long
JWT_ALGORITHM=HS384

# ---- dsh 运行时桥接（dsh_bridge）----
# Node 可执行文件（要求 Node >= 22.19），默认取 PATH 上的 node
DSH_NODE_BIN=node
# LLM 供应商路由：codewise = llm-pi-ai 手工路由（纯净 OpenAI 协议，默认）；
# deepseek-official = llm-deepseek 直连适配器（DeepSeek 思考模式/缓存计费）
DSH_PROVIDER=codewise
# 运行时入口与 cordis 组合配置，默认指向 agent-runtime/，一般无需覆盖
# DSH_RUNTIME_ENTRY=agent-runtime/node_modules/@deepseek-ai/dsh-sdk-jsonrpc-demo/lib/packaged-bin.js
# DSH_CORDIS_CONFIG=agent-runtime/cordis.yml
# 每用户模型的真实上下文窗口（token 数），直接影响 dsh compaction 触发时机
DSH_DEFAULT_CONTEXT_WINDOW=65536
# dsh 运行时子进程空闲多久后回收（秒）
DSH_IDLE_TIMEOUT_SECONDS=600
# 可选：单请求输出上限；会话根目录与 token 文件目录
# AGENT_MAX_TOKENS=8192
# DSH_SESSION_ROOT_BASE=data/dsh-sessions
# DSH_TOKEN_DIR=data/tokens

# ---- web 抓取（web_search / web_fetch）----
# 搜索 provider 二选一即可（都配置时优先 Exa）；不配置则模型只有 web_fetch。
# 注意：web_fetch 走 codewise-web 的 SSRF 守卫，仅允许 http/https 且拒绝
# localhost/环回/私有/保留地址；若部署无外网，抓取会失败。
# EXA_API_KEY=
# PERPLEXITY_API_KEY=
